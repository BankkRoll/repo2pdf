# ──────────────────────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────────────────────
node_modules/
bower_components/

# ──────────────────────────────────────────────────────────────
# Build output
# ──────────────────────────────────────────────────────────────
dist/
build/
lib-cov/

# Compiled TypeScript output (committed sources are .ts).
# Scoped to src/ so we don't accidentally ignore a legitimately
# committed .js such as bin/repo2pdf.js.
/src/**/*.js
/src/**/*.js.map
/src/**/*.d.ts

# ──────────────────────────────────────────────────────────────
# Coverage / instrumentation
# ──────────────────────────────────────────────────────────────
coverage/
.nyc_output
.grunt

# ──────────────────────────────────────────────────────────────
# Logs & runtime data
# ──────────────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# ──────────────────────────────────────────────────────────────
# Environment / secrets
# ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# Lock files from other package managers (this project uses pnpm)
yarn.lock
package-lock.json

# ──────────────────────────────────────────────────────────────
# Editors / OS
# ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────────────────────
# repo2pdf runtime artifacts
# ──────────────────────────────────────────────────────────────
output.pdf
output/
tempRepo/
.repo2pdf-cache/
.repo2pdf-temp/

# ──────────────────────────────────────────────────────────────
# Test artifacts
# ──────────────────────────────────────────────────────────────
# Generated PDF / output from test runs — never committed.
tests/output/

# Procedurally generated fixtures — recreated by
# tests/fixtures/generate-fixtures.ts (vitest global setup). Deterministic,
# regenerated on every run, so they are intentionally NOT committed.
tests/fixtures/edge-cases/
tests/fixtures/multi-language/
tests/fixtures/synthetic-large/

# NOTE (intentionally NOT ignored):
#   tests/fixtures/test-repos/*  -> tracked as git submodules (see .gitmodules)
#   tests/fixtures/mock-repo/    -> committed static fixture
