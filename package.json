{
  "name": "repo2pdf",
  "version": "3.0.0-alpha.0",
  "description": "Convert any repository to a beautiful PDF",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "repo2pdf": "bin/repo2pdf.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/code-processor.test.ts tests/config-loader.test.ts tests/error-handler.test.ts tests/logger.test.ts tests/utils.test.ts",
    "test:integration": "vitest run tests/cli.test.ts tests/fetchers.test.ts tests/pdf-generator.test.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:comprehensive": "vitest run tests/comprehensive.test.ts --testTimeout=600000",
    "test:all": "vitest run --testTimeout=600000",
    "test:coverage": "vitest run --coverage",
    "test:setup": "ts-node tests/setup-test-repos.ts",
    "test:setup:small": "ts-node tests/setup-test-repos.ts --only-small",
    "preview": "ts-node examples/generate-preview.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "repository",
    "pdf",
    "github",
    "gitlab",
    "bitbucket",
    "code",
    "documentation",
    "syntax-highlighting",
    "cli"
  ],
  "author": "BankkRoll",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BankkRoll/repo2pdf.git"
  },
  "bugs": {
    "url": "https://github.com/BankkRoll/repo2pdf/issues"
  },
  "homepage": "https://github.com/BankkRoll/repo2pdf#readme",
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "globby": "^14.0.0",
    "inquirer": "^9.2.0",
    "listr2": "^8.0.0",
    "minimatch": "^10.1.1",
    "ora": "^8.0.0",
    "p-limit": "^5.0.0",
    "puppeteer": "^22.0.0",
    "sharp": "^0.33.0",
    "shiki": "^1.0.0",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
